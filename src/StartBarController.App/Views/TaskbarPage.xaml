<UserControl x:Class="StartBarController.App.Views.TaskbarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Taskbar" />
        <TextBlock Style="{StaticResource Caption}" FontSize="13"
                   Text="Windows' own taskbar settings, in one place. Changes apply right away." />

        <TextBlock Style="{StaticResource SectionTitle}" Text="Behavior" />
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0">
                    <TextBlock Style="{StaticResource CardTitle}" Text="Automatically hide the taskbar" />
                    <TextBlock x:Name="AutoHideCaption" Style="{StaticResource Caption}"
                               Text="The taskbar slides out of view until you point at its edge." />
                </StackPanel>
                <CheckBox x:Name="AutoHideToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                          Click="OnAutoHideClick" />
            </Grid>
        </Border>
        <StackPanel x:Name="BehaviorCards" />

        <TextBlock Style="{StaticResource SectionTitle}" Text="Items" />
        <StackPanel x:Name="ItemCards" />

        <TextBlock x:Name="UnavailableNote" Style="{StaticResource Caption}" Margin="2,12,0,0" />
    </StackPanel>
</UserControl>
