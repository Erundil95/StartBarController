<Window x:Class="StartBarController.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Start Bar Controller"
        Width="1040" Height="760" MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <DockPanel Margin="8,10,4,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="14,6,0,22">
                <Image Source="Assets/app.ico" Width="20" Height="20" />
                <TextBlock Text="Start Bar Controller" Margin="12,0,0,0" FontSize="13" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Top">
                <RadioButton x:Name="NavPosition" Style="{StaticResource NavItem}" Tag="position" Checked="OnNavigate">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" />
                        <TextBlock Text="Position" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavTaskbar" Style="{StaticResource NavItem}" Tag="taskbar" Checked="OnNavigate">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE771;" />
                        <TextBlock Text="Taskbar" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
            <RadioButton x:Name="NavSettings" DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Style="{StaticResource NavItem}"
                         Tag="settings" Checked="OnNavigate">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" />
                    <TextBlock Text="Settings" Margin="14,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </RadioButton>
        </DockPanel>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="InfoBar" Margin="40,16,40,0" CornerRadius="6" Padding="14,10" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock x:Name="InfoIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" Margin="0,0,12,0" VerticalAlignment="Top"
                               Padding="0,2,0,0" />
                    <Button DockPanel.Dock="Right" Click="OnCloseInfoBar" Padding="8,4" Margin="12,0,0,0" VerticalAlignment="Top"
                            Background="Transparent" BorderThickness="0" ToolTip="Close">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="12" />
                    </Button>
                    <TextBlock x:Name="InfoText" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl x:Name="PageHost" Margin="40,20,40,32" MaxWidth="1000" />
            </ScrollViewer>
        </Grid>

        <!-- Busy overlay -->
        <Grid x:Name="BusyOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{DynamicResource SmokeFillColorDefaultBrush}">
            <Border Width="380" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8" Padding="24"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="BusyText" FontSize="16" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Text="If Windows asks for permission, accept it to continue." />
                    <ProgressBar IsIndeterminate="True" Margin="0,18,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Confirmation dialog -->
        <Grid x:Name="DialogOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{DynamicResource SmokeFillColorDefaultBrush}">
            <Border Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Margin="24,24,24,20">
                        <TextBlock x:Name="DialogTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="DialogText" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <Border Padding="24,20" CornerRadius="0,0,8,8" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                        <UniformGrid Columns="2">
                            <Button x:Name="DialogPrimary" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,4,0"
                                    HorizontalAlignment="Stretch" Click="OnDialogPrimary" />
                            <Button x:Name="DialogSecondary" Content="Cancel" Margin="4,0,0,0" HorizontalAlignment="Stretch"
                                    Click="OnDialogSecondary" IsCancel="True" />
                        </UniformGrid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
